# -----------------------------
# RAG Studio Pro - Configuracion
# -----------------------------

# Modelos por defecto
RAG_CHAT_MODEL=llama3.1:8b
RAG_EMBED_MODEL=nomic-embed-text

# Fuente web inicial
RAG_SOURCE_URL=https://es.wikipedia.org/wiki/Inteligencia_artificial

# Parametros RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_MAX_CHARS_PER_CHUNK=1200
RAG_MAX_TOTAL_CONTEXT_CHARS=4200

# Flags experimentales
RAG_ENABLE_CONTEXT_COMPRESSION=0
RAG_SEMANTIC_CACHE_ENABLED=1

# Puertos/UI
UI_HOST=0.0.0.0
UI_PORT=7860

# Rutas de almacenamiento
RAG_DATA_DIR=./data
RAG_CHROMA_DIR=./chroma_db
RAG_COLLECTION=mi_rag_multifuente

# Runtime
USER_AGENT=Manobot/1.0
RAG_LOG_LEVEL=INFO

# Logging estructurado
RAG_LOG_FILE=./logs/rag_backend.log
RAG_LOG_MAX_BYTES=1048576
RAG_LOG_BACKUP_COUNT=5
